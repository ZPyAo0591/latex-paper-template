% ============================================================
% Title
% ============================================================

\makeatletter

\renewcommand{\@maketitle}{%
    \newpage
    \begingroup
    \centering

    % Paper title: 15.5pt / 19pt bold
    {\fontsize{15.5pt}{19pt}\selectfont\bfseries\@title\par}
    % Title -> authors
    \vskip 0.25in

    % Authors
    {\normalsize
        \lineskip .5em
        \begin{tabular}[t]{c}
            \@author
        \end{tabular}\par
    }
    \endgroup

    % Author block -> abstract/main text
    \vskip 0.30in
}

\makeatother

% ============================================================
% Author formatting
% ============================================================

% Spacing between the author rows and affiliations.
\newlength{\PaperAuthorAffiliationSep}
\setlength{\PaperAuthorAffiliationSep}{0.75em}

% Author separators.
\newcommand{\PaperAuthor}[3][]{%
    \begingroup
    \PaperThisEqualContribfalse
    \PaperThisCorrespondingAuthorfalse
    \begin{tabular}{c}
        #2%
        \if\relax\detokenize{#1}\relax
        \else
            \,\textsuperscript{#1}%
        \fi
        \ifPaperThisEqualContrib
            \,\textsuperscript{\EqualContribSymbol}%
        \fi
        \ifPaperThisCorrespondingAuthor
            \,\textsuperscript{\CorrespondingAuthorSymbol}%
        \fi
        \\
        \texttt{#3}
    \end{tabular}%
    \endgroup
}

\newcommand{\PaperAffiliation}[2][]{%
    \if\relax\detokenize{#1}\relax
        #2%
    \else
        \textsuperscript{#1}\,#2%
    \fi
}

\newcommand{\PaperProject}[1]{%
    \href{#1}{\faGithub\ #1}%
}

% ============================================================
% Abstract
%
%   heading          11pt / 13pt bold small caps
%   body             10pt / 11pt
%
% The body matches the main text size.
% ============================================================

\makeatletter

\renewenvironment{abstract}{%
    \begin{list}{}{%
        \setlength{\leftmargin}{0.6in}%
        \setlength{\rightmargin}{0.6in}%
    }%
    \item[]
    {\centering
        \fontsize{11pt}{13pt}\selectfont
        \scshape\bfseries
        \abstractname\par
    }%
    \vspace{0.5ex}
    \normalsize
}{%
    \end{list}
    \vspace{1.0ex}%
}

\makeatother



% ============================================================
% Section headings
%
%   section          12pt / 14pt small caps
%   subsection       10pt / 11pt small caps
%   subsubsection    10pt / 11pt small caps
%   paragraph        10pt / 11pt bold
%   subparagraph     10pt / 11pt small caps
% ============================================================

\makeatletter

\renewcommand{\section}{%
    \@startsection{section}{1}{\z@}%
    {-2.0ex \@plus -0.5ex \@minus -.2ex}%
    {1.5ex \@plus .3ex \@minus .2ex}%
    {\normalfont\large\scshape\raggedright}%
}

\renewcommand{\subsection}{%
    \@startsection{subsection}{2}{\z@}%
    {-1.8ex \@plus -0.5ex \@minus -.2ex}%
    {0.8ex \@plus .2ex}%
    {\normalfont\normalsize\scshape\raggedright}%
}

\renewcommand{\subsubsection}{%
    \@startsection{subsubsection}{3}{\z@}%
    {-1.5ex \@plus -0.5ex \@minus -.2ex}%
    {0.5ex \@plus .2ex}%
    {\normalfont\normalsize\scshape\raggedright}%
}

\renewcommand{\paragraph}{%
    \@startsection{paragraph}{4}{\z@}%
    {1.5ex \@plus .5ex \@minus .2ex}%
    {-1em}%
    {\normalfont\normalsize\bfseries}%
}

\renewcommand{\subparagraph}{%
    \@startsection{subparagraph}{5}{\z@}%
    {1.5ex \@plus .5ex \@minus .2ex}%
    {-1em}%
    {\normalfont\normalsize\scshape}%
}

\makeatother


% ============================================================
% Table of contents behavior
% ============================================================

% Main paper entries are shown down to subsection level.
% Appendix entries are hidden from the main TOC.
\etocsettagdepth{papermain}{subsection}
\etocsettagdepth{paperappendix}{none}

% Appendix-only table of contents.
\newcommand{\PaperPrintAppendixTOC}{%
    \begingroup

    % Hide main-paper entries.
    \etocsettagdepth{papermain}{none}%

    % Show appendix entries down to subsection level.
    \etocsettagdepth{paperappendix}{subsection}%

    \etocsettocstyle{%
        \section*{Appendix Contents}%
    }{}%

    \tableofcontents

    \endgroup
}



% ============================================================
% Paragraph formatting
%
% Paragraph formatting:
%   no first-line indentation
%   small vertical space between paragraphs
% ============================================================

\setlength{\parindent}{0pt}
\setlength{\parskip}{4pt plus 0.5pt minus 0.5pt}

% ============================================================
% Optional author notes
%
% Usage:
%   Alice\eqcontrib
%   Bob\eqcontrib
%
%   Alice\corrauthor
%
% Commands may also be combined:
%   Alice\eqcontrib\corrauthor
%
% If neither command is used, no author-note footnote appears.
% ============================================================

% Symbols
\newcommand{\EqualContribSymbol}{\ensuremath{\star}}
\newcommand{\CorrespondingAuthorSymbol}{\ensuremath{\dagger}}

% Footnote text
\newcommand{\EqualContribText}{Equal contribution.}
\newcommand{\CorrespondingAuthorText}{Corresponding author.}

% Internal flags
\newif\ifPaperEqualContribUsed
\newif\ifPaperCorrespondingAuthorUsed
\newif\ifPaperThisEqualContrib
\newif\ifPaperThisCorrespondingAuthor

\PaperEqualContribUsedfalse
\PaperCorrespondingAuthorUsedfalse
\PaperThisEqualContribfalse
\PaperThisCorrespondingAuthorfalse

% Author marks
\newcommand{\eqcontrib}{%
    \global\PaperEqualContribUsedtrue
    \PaperThisEqualContribtrue
}

\newcommand{\corrauthor}{%
    \global\PaperCorrespondingAuthorUsedtrue
    \PaperThisCorrespondingAuthortrue
}

% Unnumbered author-note footnote helper
\newcommand{\PaperAuthorFootnote}[1]{%
    \begingroup
    \renewcommand{\thefootnote}{}%
    \footnotetext[0]{#1}%
    \endgroup
}

% Print only the author notes that are actually used.
\newcommand{\PaperPrintAuthorNotes}{%
    \ifPaperEqualContribUsed
        \ifPaperCorrespondingAuthorUsed
            \PaperAuthorFootnote{%
                \textsuperscript{\EqualContribSymbol}\,
                \EqualContribText
                \quad
                \textsuperscript{\CorrespondingAuthorSymbol}\,
                \CorrespondingAuthorText
            }%
        \else
            \PaperAuthorFootnote{%
                \textsuperscript{\EqualContribSymbol}\,
                \EqualContribText
            }%
        \fi
    \else
        \ifPaperCorrespondingAuthorUsed
            \PaperAuthorFootnote{%
                \textsuperscript{\CorrespondingAuthorSymbol}\,
                \CorrespondingAuthorText
            }%
        \fi
    \fi
}
% ============================================================
% Automatic hooks
% ============================================================

\AtBeginDocument{%

    % Mark the beginning of the main-paper portion of the TOC.
    \etocdepthtag.toc{papermain}%

    % --------------------------------------------------------
    % Automatically append author notes after \maketitle.
    % --------------------------------------------------------

    \let\PaperOriginalMaketitle\maketitle

    \renewcommand{\maketitle}{%
        \PaperOriginalMaketitle
        \PaperPrintAuthorNotes
    }%

    % --------------------------------------------------------
    % Automatically insert an appendix-only TOC after \appendix.
    % --------------------------------------------------------

    \let\PaperOriginalAppendix\appendix

    \renewcommand{\appendix}{%
        \PaperOriginalAppendix
        \etocdepthtag.toc{paperappendix}%
        \PaperPrintAppendixTOC
    }%
}

